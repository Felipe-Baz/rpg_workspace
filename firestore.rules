rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }

    // Mesas: lê quem é membro; escreve o mestre. Um usuário logado pode
    // apenas se adicionar a "membros" (entrada por convite) ou se remover (sair).
    match /mesas/{mesaId} {
      allow read: if logado() && request.auth.uid in resource.data.membros;

      allow create: if logado()
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.membros == [request.auth.uid];

      allow update: if logado() && (
        (resource.data.donoUid == request.auth.uid
          && request.resource.data.donoUid == resource.data.donoUid
          && request.auth.uid in request.resource.data.membros)
        ||
        // entrar na mesa
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
          && request.resource.data.membros.hasAll(resource.data.membros)
          && request.resource.data.membros.size() == resource.data.membros.size() + 1
          && request.auth.uid in request.resource.data.membros)
        ||
        // sair da mesa
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
          && request.auth.uid in resource.data.membros
          && !(request.auth.uid in request.resource.data.membros)
          && request.auth.uid != resource.data.donoUid)
        ||
        // membro assume um personagem existente (mesmo tamanho) ou cria o seu (+1);
        // no máximo um item da lista antiga pode ser alterado/removido.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jogadores'])
          && request.auth.uid in resource.data.membros
          && request.resource.data.jogadores.size() >= resource.data.jogadores.size()
          && request.resource.data.jogadores.size() <= resource.data.jogadores.size() + 1
          && resource.data.jogadores.toSet().difference(request.resource.data.jogadores.toSet()).size() <= 1
          && request.resource.data.jogadores.toSet().difference(resource.data.jogadores.toSet()).size() == 1)
      );

      allow delete: if logado() && resource.data.donoUid == request.auth.uid;

      // Diário do jogador: privado, só o próprio dono (e membro da mesa).
      // O mestre também lê (nunca escreve), para a visão "ver como jogador".
      match /anotacoes/{donoId} {
        allow read, write: if logado() && request.auth.uid == donoId
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
        allow read: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Mapas: o mestre escreve; o jogador lê só os liberados (para todos ou para ele).
      match /mapas/{mapaId} {
        allow read: if logado() && (
          get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid
          || (request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros
              && (resource.data.todos == true || request.auth.uid in resource.data.liberadoPara)));
        allow write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Imagens (handouts): o mestre escreve; o jogador lê só os liberados (para todos ou para ele).
      match /imagens/{mapaId} {
        allow read: if logado() && (
          get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid
          || (request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros
              && (resource.data.todos == true || request.auth.uid in resource.data.liberadoPara)));
        allow write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Cenas e assets do editor de mapas: somente o mestre (jogador só vê o render em `mapas`).
      match /cenas/{cenaId} {
        allow read, write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }
      // Temas de estilo (mapas por IA): somente o mestre.
      match /temas/{temaId} {
        allow read, write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }
      match /assets/{assetId} {
        allow read, write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Mundo (lore público): o mestre escreve; qualquer membro lê.
      match /mundo/{docId} {
        allow read: if logado()
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
        allow write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Missões: o mestre escreve; qualquer membro lê.
      match /missoes/{missaoId} {
        allow read: if logado()
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
        allow write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Missões (visão pública, derivada): sem etapas pendentes nem notas.
      // A visão completa fica em missoesMestre, que só o mestre acessa.
      match /missoesMestre/{missaoId} {
        allow read, write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Ilustrações das missões: o mestre escreve; qualquer membro lê.
      match /missoesImagens/{imagemId} {
        allow read: if logado()
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
        allow write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Pinos do jogador: privados (só o próprio dono, sendo membro).
      match /pinos/{donoId} {
        allow read, write: if logado() && request.auth.uid == donoId
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
        allow read: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Fichas (NPCs, inimigos, pessoas importantes, itens).
      // - Do jogador: privadas (só o dono). Não podem ser liberadas a ninguém.
      // - Do mestre (mestre == true): o mestre escreve; o jogador lê só as liberadas
      //   (para todos ou para ele).
      match /fichas/{fichaId} {
        allow read: if logado() && (
          (resource.data.donoUid == request.auth.uid
            && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros)
          || (resource.data.get('mestre', false) == true && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid)
          || (request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros
              && resource.data.get('mestre', false) == true
              && (resource.data.get('todos', false) == true
                  || request.auth.uid in resource.data.get('liberadoPara', [])))
        );
        allow create: if logado() && request.resource.data.donoUid == request.auth.uid
          && (
            (request.resource.data.get('mestre', false) == false
              && request.resource.data.get('todos', false) == false
              && request.resource.data.get('liberadoPara', []).size() == 0
              && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros)
            || (request.resource.data.mestre == true
              && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid)
          );
        allow update: if logado() && resource.data.donoUid == request.auth.uid
          && request.resource.data.donoUid == request.auth.uid
          && request.resource.data.get('mestre', false) == resource.data.get('mestre', false)
          && (
            (resource.data.get('mestre', false) == false
              && request.resource.data.get('todos', false) == false
              && request.resource.data.get('liberadoPara', []).size() == 0
              && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros)
            || (resource.data.mestre == true
              && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid)
          );
        allow delete: if logado() && resource.data.donoUid == request.auth.uid
          && (resource.data.get('mestre', false) == true
              || request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros);
      }

      // Quadro de investigação: elementos privados do jogador que os criou.
      match /quadro/{noId} {
        allow read: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
        allow read, delete: if logado() && resource.data.donoUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
        allow create: if logado() && request.resource.data.donoUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
        allow update: if logado() && resource.data.donoUid == request.auth.uid
          && request.resource.data.donoUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
      }

      // ===== Marcas de Pacto (Mestre = donoUid da mesa; jogadores = membros) =====
      function mestreMesa() {
        return logado() && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }
      function membroMesa() {
        return logado() && request.auth.uid in get(/databases/$(database)/documents/mesas/$(mesaId)).data.membros;
      }

      // A extensão nativa Marcas de Pacto é EXCLUSIVA da mesa abaixo (mantenha igual a MESA_PADRAO em src/lib/marcas-const.ts;
      // um teste confere). Em qualquer outra mesa estas coleções ficam fechadas para todos, inclusive o mestre.
      function mesaDasMarcas() {
        return mesaId == '5010347d-14e3-49e2-adb9-eb3bc0952013';
      }
      // O mestre pode ocultar as Marcas dos jogadores (extensoesNativas/marcas-de-pacto.visivelJogadores == false).
      function marcasLiberadas() {
        let p = /databases/$(database)/documents/mesas/$(mesaId)/extensoesNativas/marcas-de-pacto;
        return !exists(p) || get(p).data.get('visivelJogadores', true) != false;
      }
      function marcasMestre() {
        return mesaDasMarcas() && mestreMesa();
      }
      function marcasJogador() {
        return mesaDasMarcas() && membroMesa() && marcasLiberadas();
      }

      match /players/{uid} {
        allow read: if marcasMestre() || (marcasJogador() && request.auth.uid == uid);
        allow create, update: if marcasJogador() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['joinedAt', 'name']);
        allow delete: if marcasMestre();
      }

      // Atribuição: só o Mestre escreve; o jogador só lê a própria.
      match /assignments/{uid} {
        allow get: if marcasMestre() || (marcasJogador() && request.auth.uid == uid);
        allow list: if marcasMestre();
        allow write: if marcasMestre();
      }

      // Anotações: o jogador lê/escreve as próprias (com Marca atribuída); Mestre só lê.
      match /notes/{uid} {
        allow get: if marcasMestre() || (marcasJogador() && request.auth.uid == uid);
        allow list: if marcasMestre();
        allow write: if marcasJogador() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/mesas/$(mesaId)/assignments/$(uid));
      }

      // Gabarito: SOMENTE o Mestre. Nunca vai ao cliente de jogador.
      match /lore/{markId} {
        allow read, write: if marcasMestre();
      }

      // ----- Enigmas -----
      // Banco completo (com gabarito): SOMENTE o Mestre.
      match /puzzles/{markId} {
        allow read, write: if marcasMestre();
      }
      // Etapas já liberadas ao jogador (sem gabarito): Mestre escreve, o dono lê.
      match /released/{uid} {
        allow get: if marcasMestre() || (marcasJogador() && request.auth.uid == uid);
        allow list: if marcasMestre();
        allow write: if marcasMestre();
      }
      // Respostas do jogador: ele escreve, Mestre lê.
      match /puzzleResp/{uid} {
        allow get: if marcasMestre() || (marcasJogador() && request.auth.uid == uid);
        allow list: if marcasMestre();
        allow create, update: if marcasJogador() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/mesas/$(mesaId)/assignments/$(uid));
        allow delete: if marcasMestre();
      }
      // Veredito (aprovada/recusada): só o Mestre escreve; o jogador lê o próprio.
      match /puzzleStatus/{uid} {
        allow get: if marcasMestre() || (marcasJogador() && request.auth.uid == uid);
        allow list: if marcasMestre();
        allow write: if marcasMestre();
      }

      // Ficha de personagem (D&D 5e): documento do jogador (id = uid). O dono lê e edita; o mestre lê e edita todas.
      match /personagens/{donoId} {
        allow read: if mestreMesa() || (membroMesa() && request.auth.uid == donoId);
        allow write: if mestreMesa() || (membroMesa() && request.auth.uid == donoId);
      }

      // Notas e segredos: somente o mestre.
      match /segredos/{docId} {
        allow read, write: if logado()
          && get(/databases/$(database)/documents/mesas/$(mesaId)).data.donoUid == request.auth.uid;
      }

      // Uso de IA (contadores e teto): o mestre lê; só o servidor (Admin SDK) escreve.
      match /uso/{docId} {
        allow read: if mestreMesa();
        allow write: if false;
      }
      match /usoRegistros/{docId} {
        allow read: if mestreMesa();
        allow write: if false;
      }

      // Extensões instaladas na mesa (HTML criado com IA, executado em iframe isolado).
      // O mestre gerencia; o jogador lê só as marcadas como visíveis.
      match /extensoes/{extId} {
        allow read: if logado() && (mestreMesa() || (membroMesa() && resource.data.get('visivelJogadores', false) == true));
        allow write: if mestreMesa();

        // ===== Estado por escopo (E7) =====
        // mestre      → só o mestre lê e grava (gabaritos, segredos)
        // para_{uid}  → o mestre grava; só aquele jogador lê
        // de_{uid}    → o próprio jogador grava (sem aprovação); o mestre lê e apaga, nunca grava
        // Para jogadores, tudo exige a extensão visível, ativa e o escopo em `estadoAprovado` (aprovado pelo mestre).
        function inst() {
          return get(/databases/$(database)/documents/mesas/$(mesaId)/extensoes/$(extId)).data;
        }
        function instAberta() {
          let i = inst();
          return i.get('visivelJogadores', false) == true && i.get('ativa', true) != false;
        }
        function escopoAprovado(e) {
          return e in inst().get('estadoAprovado', []);
        }
        function docEstadoValido() {
          return request.resource.data.keys().hasOnly(['json', 'uid', 'atualizadoEm'])
            && request.resource.data.json is string && request.resource.data.json.size() <= 50000
            && request.resource.data.atualizadoEm is number;
        }

        match /estado/{docId} {
          allow read, delete: if mestreMesa();
          allow create, update: if mestreMesa() && (docId == 'mestre' || docId.matches('para_.+')) && docEstadoValido();
          allow get: if membroMesa() && instAberta() && (
            (docId == 'para_' + request.auth.uid && escopoAprovado('porJogador'))
            || (docId == 'de_' + request.auth.uid && escopoAprovado('doJogador')));
          allow create, update: if membroMesa() && docId == 'de_' + request.auth.uid && instAberta() && escopoAprovado('doJogador')
            && docEstadoValido() && request.resource.data.uid == request.auth.uid;
        }
      }

      // Registros dos tipos de dado criados por extensões: o mestre gerencia; o jogador lê só os liberados.
      match /recursosDados/{registroId} {
        allow read: if mestreMesa() || (membroMesa() && resource.data.liberado == true);
        allow write: if mestreMesa();
      }

      // Pedidos de jogadores a extensões: o jogador cria e lê os próprios; o mestre lê, aprova e recusa.
      match /extensoesPedidos/{pedidoId} {
        allow read: if mestreMesa() || (membroMesa() && resource.data.de == request.auth.uid);
        allow create: if membroMesa() && request.resource.data.de == request.auth.uid && request.resource.data.status == 'pendente'
          && request.resource.data.keys().hasOnly(['id', 'extId', 'extTitulo', 'de', 'nome', 'acoes', 'criadoEm', 'status', 'resolvidoEm', 'lote'])
          && request.resource.data.acoes is list && request.resource.data.acoes.size() > 0 && request.resource.data.acoes.size() <= 20
          && request.resource.data.resolvidoEm == null && request.resource.data.lote == null
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 80;
        allow update, delete: if mestreMesa();
      }

      // Lotes de conteúdo criado por extensões (para listar e desfazer): só o mestre.
      match /extensoesLotes/{loteId} {
        allow read, write: if mestreMesa();
      }

      // Escolhas do mestre sobre extensões nativas (ex.: liberar Marcas de Pacto aos jogadores).
      // Membros leem (para saber o que mostrar); só o mestre grava.
      match /extensoesNativas/{extId} {
        allow read: if membroMesa();
        allow write: if mestreMesa();
      }

      // Rolagens de dados da mesa: qualquer membro lê (quem está online repete a animação) e cria as próprias.
      // Imutáveis depois de criadas; só quem rolou ou o mestre apaga.
      match /rolagens/{rolagemId} {
        allow read: if membroMesa();
        allow create: if membroMesa()
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'expressao', 'total', 'rolagem', 'jogada', 'em', 'rotulo', 'criadoEm'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 60
          && request.resource.data.expressao is string && request.resource.data.expressao.size() <= 60
          && request.resource.data.total is number
          && request.resource.data.rolagem is map
          && (request.resource.data.jogada == null
              || (request.resource.data.jogada is map && request.resource.data.jogada.dados.size() <= 24))
          && request.resource.data.em is number
          && (request.resource.data.rotulo == null || (request.resource.data.rotulo is string && request.resource.data.rotulo.size() <= 80))
          && request.resource.data.criadoEm == request.time;
        allow update: if false;
        allow delete: if mestreMesa() || (membroMesa() && resource.data.uid == request.auth.uid);
      }

      // Pedidos de teste do mestre a um jogador. O mestre cria/apaga e lê todos; o jogador alvo lê só os seus e,
      // para responder, muda apenas status/total/natural/origem/respondidoEm de um pedido pendente.
      match /pedidosTeste/{pedidoId} {
        allow read: if mestreMesa() || (membroMesa() && resource.data.paraUid == request.auth.uid);
        allow create: if mestreMesa()
          && request.resource.data.keys().hasOnly(['paraUid', 'paraNome', 'tipo', 'chave', 'vantagem', 'motivo', 'status', 'criadoEm'])
          && request.resource.data.paraUid is string
          && request.resource.data.paraNome is string && request.resource.data.paraNome.size() <= 60
          && request.resource.data.tipo in ['pericia', 'atributo', 'salvaguarda', 'iniciativa', 'livre']
          && request.resource.data.chave is string && request.resource.data.chave.size() <= 60
          && (request.resource.data.vantagem == null || request.resource.data.vantagem in ['v', 'd'])
          && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 200
          && request.resource.data.status == 'pendente'
          && request.resource.data.criadoEm is number;
        allow update: if mestreMesa()
          || (membroMesa() && resource.data.paraUid == request.auth.uid && resource.data.status == 'pendente'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'total', 'natural', 'origem', 'respondidoEm'])
              && request.resource.data.status == 'respondido'
              && request.resource.data.total is number && request.resource.data.natural is number
              && request.resource.data.origem in ['site', 'mesa']);
        allow delete: if mestreMesa();
      }

      // Jobs de geração de assets: o mestre acompanha (onSnapshot); só o servidor (Admin SDK) escreve.
      match /jobs/{jobId} {
        allow read: if mestreMesa();
        allow write: if false;
      }
    }

    // Configuração de IA do usuário (provedores ativos e chaves cifradas): acessada
    // somente pelo servidor (Admin SDK). O cliente nunca lê nem escreve, em especial segredos.
    match /usuarios/{uid}/{document=**} {
      allow read, write: if false;
    }

    // Biblioteca de extensões do mestre: privada (só o dono lê e escreve).
    match /extensoes/{extId} {
      allow read: if logado() && resource.data.donoUid == request.auth.uid;
      allow create: if logado() && request.resource.data.donoUid == request.auth.uid;
      allow update, delete: if logado() && resource.data.donoUid == request.auth.uid
        && request.resource.data.donoUid == request.auth.uid;
    }

    // Biblioteca pública: assets gerados por IA, legíveis por qualquer usuário logado.
    // Só o servidor (Admin SDK) escreve. Assets enviados (PNG) nunca entram aqui.
    match /assetsPublicos/{assetId} {
      allow read: if logado();
      allow write: if false;
    }

    // Sistemas de jogo públicos (dropdown ao criar mesa): qualquer logado lê; só o servidor escreve.
    match /sistemas/{id} {
      allow read: if logado();
      allow write: if false;
    }

    // Sistemas cadastrados pelo usuário: visíveis só para ele.
    match /sistemasPessoais/{id} {
      allow read, delete: if logado() && resource.data.donoUid == request.auth.uid;
      allow create: if logado() && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['donoUid', 'nome', 'criadoEm'])
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60;
      allow update: if false;
    }

    // Ranking do minijogo (Caça aos Corvos): um doc por usuário com a melhor pontuação.
    // Qualquer logado lê; cada um só grava o próprio doc e só pode subir a pontuação.
    match /rankingJogo/{uid} {
      function rankingValido() {
        return request.resource.data.keys().hasOnly(['uid', 'nick', 'pontos', 'em'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.nick is string
          && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 16
          && request.resource.data.pontos is int
          && request.resource.data.pontos > 0 && request.resource.data.pontos <= 30000
          && request.resource.data.em == request.time;
      }
      allow read: if logado();
      allow create: if logado() && uid == request.auth.uid && rankingValido();
      allow update: if logado() && uid == request.auth.uid && rankingValido()
        && request.resource.data.pontos > resource.data.pontos;
      allow delete: if logado() && uid == request.auth.uid;
    }

    // Convites: código -> mesa. Só leitura por código exato (sem listar).
    match /convites/{codigo} {
      allow get: if logado();
      allow list: if false;
      allow create: if logado() && request.resource.data.donoUid == request.auth.uid;
      allow delete: if logado() && resource.data.donoUid == request.auth.uid;
    }
  }
}
