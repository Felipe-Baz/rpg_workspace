# Modelo de configuração: copie para .env (ou .env.local) e preencha.
# Esses arquivos são ignorados pelo git; só este modelo, sem valores, vai para o repositório.

# --- Firebase (cliente) ---
# Console do Firebase > Configurações do projeto > Seus apps > App da Web > Configuração do SDK.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (só servidor; NUNCA com prefixo NEXT_PUBLIC_) ---
# Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
# Cole o JSON inteiro em UMA linha, entre aspas simples.
FIREBASE_ADMIN_CREDENTIALS=

# --- Cifra das chaves de IA dos mestres (só servidor) ---
# 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida as chaves de IA já salvas (os mestres precisam reinseri-las).
IA_CHAVE_MESTRA=

# --- Opcional: só para scripts/validar-*.ts ---
# GOOGLE_API_KEY=
# GEMINI_MODELO=
# SEM_LLM=1
# SO=sprite,textura
